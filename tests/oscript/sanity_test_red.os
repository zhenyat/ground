///////////////////////////////////////////////////////////////////////////////
// sanity-test_red.os
// sanity check of the OneScript test harness (1testrunner + asserts).
// Проверяет не бизнес-логику, а сам стенд: умеет ли runner падать и проходить.
// Version:      1.0
//
// Author:       Claude Sonnet 5.5
// Created:      2026-10-20
// Last updated: 2026-10-21 ZT
///////////////////////////////////////////////////////////////////////////////

// Подключение библиотеки утверждений; 1testrunner находит её в /opt/onescript/lib
#Использовать asserts

Перем юТест;

// Точка входа для 1testrunner: возвращает ИМЕНА экспортных процедур-тестов этого файла.
// Каждый новый тест в этом стиле приходится дописывать в список вручную.
Функция ПолучитьСписокТестов(ЮнитТестирование) Экспорт

    юТест = ЮнитТестирование;

    ВсеТесты = Новый Массив;
    ВсеТесты.Добавить("ТестДолжен_ПроверитьСложение");
    Возврат ВсеТесты;

КонецФункции

// RED: ожидание НАМЕРЕННО неверное (2 вместо 3) — тест обязан упасть.
Процедура ТестДолжен_ПроверитьСложение() Экспорт

    Утверждения.ПроверитьРавенство(2, 1 + 2);

КонецПроцедуры