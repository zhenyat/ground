// Created:      2026-10-20
// Last updated: 2026-10-20
///////////////////////////////////////////////////////////////////////////////

#Использовать asserts

Перем Калькулятор;

// Вызывается перед КАЖДЫМ тестом: у каждого теста свой новый экземпляр класса,
// чтобы тесты не влияли друг на друга (изоляция).
&Перед
Процедура СоздатьКалькулятор() Экспорт

	ПутьКласса = ОбъединитьПути(ТекущийКаталог(), "scripts/oscript/kata/StringCalculator.os");
    Калькулятор = ЗагрузитьСценарий(ПутьКласса);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНоль_ДляПустойСтроки() Экспорт

    // порядок аргументов: (Ожидаемое, Фактическое)
    Утверждения.ПроверитьРавенство(0, Калькулятор.Сложить(""));
    Утверждения.ПроверитьРавенство(1, Калькулятор.Сложить("1"));
    Утверждения.ПроверитьРавенство(6, Калькулятор.Сложить("1,2,3"));
    Утверждения.ПроверитьРавенство(3, Калькулятор.Сложить("1,2"));
КонецПроцедуры
