# Скопируйте в bin/.env (файл в .gitignore) и поправьте под вашу машину —
# на Linux Mint и macOS пути будут разными, это нормально, .env как раз для
# этого и существует.

# Update the line below!
IB_PATH="${HOME}/1C/IB/ground"

# Путь к исполняемому файлу Конфигуратора (НЕ ibcmd — см. пояснение в
# bin/push.sh/pull.sh). На Linux обычно /opt/1cv8/x86_64/<версия>/1cv8,
# на macOS — внутри /Applications/1cEnterprise.app/. Узнайте точный путь
# командой: find /opt/1cv8 -maxdepth 3 -name '1cv8' 2>/dev/null (Linux)

# Uncomment for macOS
#     DESIGNER_BIN=Applications/1cv8t.localized/8.5.1.1150/1cv8t.app/Contents/MacOS/1cv8t"
# Uncomment for Linux
# DESIGNER_BIN="/opt/1cv8t/x86_64/8.5.1.1150/1cv8t"

# Пользователь ИБ. На учебной версии без настроенных пользователей часто
# достаточно оставить пустым (см. комментарий в push.sh про /N и /P).
IB_USER=""
IB_PASSWORD=""
