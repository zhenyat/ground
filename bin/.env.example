# Скопируйте в bin/.env (файл в .gitignore) и поправьте под вашу машину —
# на Linux Mint и macOS пути будут разными, это нормально, .env как раз для
# этого и существует.

# --- Корень данных 1С -------------------------------------------------------
# HOME_1C — ГЛОБАЛЬНАЯ переменная среды, один раз на машине в ~/.zshrc:
#     export HOME_1C="$HOME/1C"
# (слово export обязательно: bin/*.sh — дочерние процессы). Здесь переменная
# только проверяется: пустая HOME_1C превратила бы IB_PATH в "/IB/<имя>".
: "${HOME_1C:?HOME_1C не задана. Добавьте в ~/.zshrc: export HOME_1C=$HOME/1C}"

case "${HOME_1C}" in
    /*) ;;
    *)  echo "HOME_1C должна быть абсолютным путём, сейчас: ${HOME_1C}" >&2; return 1 ;;
esac

# --- Инфобаза и выгрузка (вне репозитория) ------------------------------------
# Пути строятся из HOME_1C на этапе чтения .env, а не при генерации проекта —
# поэтому файл переносим между машинами.
IB_NAME="ground"
IB_PATH="${HOME_1C}/IB/${IB_NAME}"
DUMP_DIR="${HOME_1C}/IB/DUMP/${IB_NAME}"

# --- Платформа ------------------------------------------------------------------
# Путь к исполняемому файлу Конфигуратора (НЕ ibcmd — см. пояснение в bin/push.sh/pull.sh).
# На Linux обычно: /opt/1cv8/x86_64/<версия>/1cv8,
# На macOS: внутри /Applications/1cEnterprise.app/.
# Узнайте точный путь командой: find /opt -maxdepth 4 -name \*1cv8\* 2>/dev/null

# Uncomment for macOS (Training version)
# DESIGNER_BIN="/Applications/1cv8t.localized/8.5.1.1150/1cv8t.app/Contents/MacOS/1cv8t"
# Uncomment for Linux (Commercial version)
# DESIGNER_BIN="/opt/1cv8/x86_64/8.5.1.1529/1cv8"
# Uncomment for Linux (Training version)
# DESIGNER_BIN="/opt/1cv8t/x86_64/8.5.1.1150/1cv8t" # Training version

# Пользователь ИБ. На учебной версии без настроенных пользователей часто
# достаточно оставить пустым (см. комментарий в push.sh про /N и /P).
IB_USER=""
IB_PASSWORD=""
