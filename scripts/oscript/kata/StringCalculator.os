// Заглушка: файл компилируется, но поведения пока нет. Поэтому первый запуск
// теста будет красным ПО ЗНАЧЕНИЮ, а не из-за ошибки компиляции.

// Функция Сложить(Знач Числа) Экспорт
//     Возврат Неопределено;
// КонецФункции

Функция Сложить(Знач Числа) Экспорт

    Если ПустаяСтрока(Числа) Тогда
        Возврат 0;
    КонецЕсли;

    Сумма = 0;
    Для Каждого Часть Из СтрРазделить(Числа, ",") Цикл
        Сумма = Сумма + Число(Часть);
    КонецЦикла;

    Возврат Сумма;

КонецФункции
