# ==========================================
# 1С:Enterprise 8.x — бинарные артефакты
# ==========================================
# Инфобаза принципиально ХРАНИТСЯ ВНЕ этого репозитория (см. bin/.env,
# ~/IB/<project>), поэтому паттерны ниже — страховка на случай, если
# кто-то по ошибке запустит выгрузку прямо внутрь src/ или уронит файл базы
# сюда вручную.
*.1CD
*.cdc
*.cfl
*.cfs
*.cfu
*.dt
*.epf
*.erf
*.ertf
*.mft
*.std
*.st
1Cv8.lst
1Cv8.1CD
1Cv8.log
*.lgf
*.lgp
~*.tmp
~*.bak
*.tmp
*.bak
*.cache
*.lock
*.lck

# Исключение: наши собственные внешние обработки в scripts/epf/ — рабочий
# инструмент, а не мусор, их коммитим осознанно.
!scripts/epf/**/*.epf

# ==========================================
# Секреты и локальные пути
# ==========================================
bin/.env
config/*.local.json
*.secret
*.key
*.pem
*.crt

# ==========================================
# var/ — runtime-артефакты (логи, temp) — не версионируем вообще
# ==========================================
var/

# ==========================================
# docs/reference/ — официальная документация платформы (копирайт,
# большой объём) — версионируем только список ссылок
# ==========================================
docs/reference/*
!docs/reference/LINKS.md

# ==========================================
# macOS
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.apdisk

# ==========================================
# Linux
# ==========================================
*~
.*.swp
.*.swo
.*.un~
core.*
*.pid
*.sock

# ==========================================
# Python (scripts/loaders/)
# ==========================================
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ==========================================
# IDE
# ==========================================
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-*

# ==========================================
# Системные
# ==========================================
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
